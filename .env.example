# Shards of Stone 3D Asset Pipeline API Keys

# Google Gemini API Key (for 2D concept generation & cleanup)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Meshy API Key (for 2D-to-3D mesh synthesis)
# Obtain from https://www.meshy.ai/
MESHY_API_KEY=your_meshy_api_key_here

# Anthropic API Key (optional, for Claude Opus / Astra agentic rigging assistance)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to Blender executable (defaults to 'blender' in PATH if unset)
# macOS default: /Applications/Blender.app/Contents/MacOS/Blender
# Linux default: /usr/bin/blender
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
