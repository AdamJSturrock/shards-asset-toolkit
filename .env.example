# Shards of Stone 3D Asset Pipeline: API keys and paths (placeholders only)

# Google Gemini API key (2D concept generation)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Meshy API key (image-to-3D meshes and the humanoid auto-rig)
# Obtain from https://www.meshy.ai/
MESHY_API_KEY=your_meshy_api_key_here

# Anthropic API key (optional: only if you drive the Blender steps with a coding agent; the scripts never call it)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to the Blender executable (defaults to 'blender' on PATH if unset)
# macOS default: /Applications/Blender.app/Contents/MacOS/Blender
# Linux default: /usr/bin/blender
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# Optional: Python used for the non-Blender critter scripts (needs numpy, scipy, Pillow)
# PYTHON=python3

# Optional: your own critter profiles file, and where critter working files go
# CRITTER_PROFILES=./my-profiles.json
# CRITTER_AUTHORING_OUT=./output/critter-authoring
